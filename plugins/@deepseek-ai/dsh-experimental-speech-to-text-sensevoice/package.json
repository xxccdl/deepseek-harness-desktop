{
  "name": "@deepseek-ai/dsh-experimental-speech-to-text-sensevoice",
  "description": "Local SenseVoice ONNX transcription with a managed sherpa-onnx process",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/speech-to-text-sensevoice"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "runtime/assets.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3",
    "sherpa-onnx-node": "1.13.8",
    "undici": "^8.10.0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-timeout": "0.1.7-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-rc.2"
  }
}