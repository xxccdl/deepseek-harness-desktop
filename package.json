{
    "name": "dsh-desktop",
    "version": "1.7.0",
    "description": "DeepSeek Harness desktop app — the dsh web surface in a native Electron shell",
    "author": "DeepSeek Harness Desktop",
    "type": "module",
    "main": "src/main.js",
    "private": true,
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "icon": "node scripts/make-icon.mjs",
        "dist": "electron-builder --win",
        "dist:portable": "electron-builder --win portable"
    },
    "dependencies": {
        "@deepseek-ai/cordis-plugin-group": "^1.0.1",
        "@deepseek-ai/dsh": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-anonymous-user-id": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-app-boot": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-atomic-write": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-bash-local": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-cmdline": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-compaction": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-fs": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-invariants": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-launch-environment": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-output-retention": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-sandbox": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-scope": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-session-telemetry": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-session-title-llm": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-shell": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-spill": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-subprocess": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-timeout": "0.1.7-alpha.1",
        "@deepseek-ai/dsh-workflow": "0.1.7-alpha.1",
        "@jridgewell/gen-mapping": "^0.3.13",
        "@yarnpkg/parsers": "^3.1.0",
        "acorn": "^8.17.0",
        "buffer": "^6.0.3",
        "readable-stream": "^4.7.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "undici": "^8.10.0"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "electron": "43.0.0",
        "electron-builder": "^26.0.12"
    },
    "build": {
        "appId": "ai.deepseek.harness.desktop",
        "productName": "DeepSeek Harness",
        "asar": false,
        "npmRebuild": false,
        "afterPack": "scripts/after-pack.cjs",
        "electronDownload": {
            "isVerifyChecksum": false
        },
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "resources/**/*",
            "package.json",
            "node_modules/@deepseek-ai/**/*"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "resources/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": "always",
            "shortcutName": "DeepSeek Harness"
        }
    },
    "allowScripts": {
        "@deepseek-ai/dsh-subprocess-local@0.1.7-alpha.1": true,
        "node-pty@1.2.0-beta.15": true,
        "koffi@3.3.1": true
    }
}
